# etc/topology/overrides/<deployment-profile>.<environment>.env
# The profile delta. Everything omitted is inherited from:
#   etc/topology/base.env
#   etc/topology/environments/<environment>.base.env
#   etc/topology/<deployment-profile>.base.env
# Do not edit the generated etc/topology/<profile-id>.env file.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.production
SDKWORK_<APPLICATION_CODE>_APPLICATION_PUBLIC_HTTP_URL=https://app.example.com
SDKWORK_<APPLICATION_CODE>_PLATFORM_API_GATEWAY_HTTP_URL=https://api.example.com
# ${KEY} references are expanded after the merge; an unresolved reference fails.
# Example:
# SDKWORK_APP_HEALTH_URL=${SDKWORK_APP_APPLICATION_PUBLIC_HTTP_URL}/healthz
