
# SDKWork local environment and runtime config overrides.
# Canonical shapes only (ENVIRONMENT_SPEC.md 5.1.7): `.env`, `.env.example`, and
# `.env.<deployment-profile>.<environment>`. Private values live in the user
# credential bundle, never in a repository file.
.env
.env.*
!.env.example
!.env.*.example
# Host and packaging configuration is not a Vite env file; the `.example`
# templates are checked in and the materialized files are not.
config/host/postgres.env
config/host/sqlite.env
apps/*/packaging/*.env
config/*.local.toml

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/

# Local tooling and workspace state
.mimocode/
**/.mimocode/
# Agent working-memory scratch files (never commit)
.wm-*
/.wm-*
.sdkwork/local/
.sdkwork/tmp/
.sdkwork/cache/
.sdkwork/secrets/
**/.sdkwork/local/
**/.sdkwork/tmp/
**/.sdkwork/cache/
**/.sdkwork/secrets/
tools/.gateway-alignment-report.json

# Forbidden source-tree runtime state remains ignored as defense against accidental commits.
.runtime/
**/.runtime/
target/
/target/
**/target/
dist/
**/dist/
coverage/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
**/.sdkwork/dart/pub-cache/
**/.sdkwork/manual-backups/
**/.sdkwork/sdkwork-generator-changes.json
**/.sdkwork/sdkwork-generator-manifest.json
**/.sdkwork/sdkwork-generator-report.json

# Common runtime/build artifacts (auto-aligned)
*.sqlite-shm
*.sqlite-wal
**/test-results/
.turbo/
**/.turbo/
*.tsbuildinfo
**/.cache/


# SDKWork local-only and generated artifacts
**/build/
*.log
.DS_Store
Thumbs.db

tools/_tmp-*
tools/_fix_*.mjs
tools/tmp-*.mjs
tools/_*.txt
tools/postgres/tmp-*.cjs
# Runtime-generated environment configuration
**/public/runtime-env.json

# SDKWork baseline ignore patterns (auto-appended)
etc/**/*.local.*
/etc/secrets/


.workbuddy/
# Local scratch under bin/ stays ignored, but the normative shared library
# (MODULE_BIN_SPEC.md §3: bin/lib/sdkwork-*.sh) MUST be version-controlled.
!/bin/lib/

# Local scratch and audit output
.tmp/
.tmp-conformance.txt
.tmp-*

# Python bytecode: regenerated by the interpreter on import, not authored content
__pycache__/

# ---- auto-audited: local artifacts that must never be committed ----
*.key
*.pem
*.p12
*.pfx
*.keystore
tmp/
temp/
*.tmp
*.temp
.next/
