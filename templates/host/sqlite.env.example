# SDKWork client-local SQLite profile.
# Canonical source: sdkwork-specs/ENVIRONMENT_SPEC.md section 7.2.
# Copy to .env.sqlite in the selected client/desktop application root for
# host-local overrides. Do not commit .env.sqlite.
#
# Client-local SQLite (desktop, tablet, mobile, and other native clients) uses
# SDKWORK_DATABASE_SQLITE_URL as the single source of truth for the local
# database file. It is independent of the server PostgreSQL profile and MAY
# coexist with it in one process. Server/container deployments MUST NOT set it.
#
# The file MUST live under the SDKWork user private data directory, not beside
# the executable and not under server data directories.

SDKWORK_DATABASE_SQLITE_URL=sqlite:///%USERPROFILE%/.sdkwork/birdcoder/data/birdcoder.sqlite3

# Pool and lifecycle policy continue to use the SDKWORK_DATABASE_* pool keys.
SDKWORK_DATABASE_MAX_CONNECTIONS=4
SDKWORK_DATABASE_MIN_CONNECTIONS=1
SDKWORK_DATABASE_ACQUIRE_TIMEOUT=10
SDKWORK_DATABASE_IDLE_TIMEOUT=300
SDKWORK_DATABASE_MAX_LIFETIME=1800
